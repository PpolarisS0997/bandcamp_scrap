# Configuration email pour Bandcamp Scraper
# Copiez ce fichier en .env et remplissez vos informations

# Serveur IMAP
IMAP_HOST=imap.gmail.com
IMAP_PORT=993

# Identifiants
# Pour Gmail : utilisez un App Password (https://myaccount.google.com/apppasswords)
# Pour Outlook : imap-mail.outlook.com / votre mot de passe
# Pour Yahoo : imap.mail.yahoo.com / App Password
EMAIL_ADDRESS=votre-email@gmail.com
EMAIL_PASSWORD=votre-app-password

# Dossier à scanner (optionnel, défaut: INBOX)
IMAP_FOLDER=INBOX
